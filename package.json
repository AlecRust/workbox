{
  "name": "@alecrust/workbox",
  "version": "0.4.4",
  "description": "Bun-first CLI for managing Git worktree sandboxes.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlecRust/workbox.git"
  },
  "homepage": "https://github.com/AlecRust/workbox#readme",
  "bugs": {
    "url": "https://github.com/AlecRust/workbox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "workbox": "src/cli.ts",
    "wkb": "src/cli.ts"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "prepare": "bun scripts/prepare.ts",
    "test": "bun test",
    "lint": "biome lint .",
    "check:types": "tsc --noEmit",
    "check:unused": "knip",
    "check": "bun run lint && bun run check:types && bun run check:unused",
    "format": "biome check --write ."
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "git",
    "worktree",
    "cli",
    "bun"
  ]
}
